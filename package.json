{
  "name": "screen-recorder",
  "version": "1.0.0",
  "description": "A modern web-based screen recording application that allows users to capture, edit, and share their screen recordings with ease.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run watch:css\" \"python3 -m http.server 8000\"",
    "build:css": "tailwindcss -i ./src/css/styles.css -o ./dist/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/css/styles.css -o ./dist/styles.css --watch",
    "build": "npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FraterCCCLXIII/BreamStream.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/FraterCCCLXIII/BreamStream/issues"
  },
  "homepage": "https://github.com/FraterCCCLXIII/BreamStream#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  }
}
